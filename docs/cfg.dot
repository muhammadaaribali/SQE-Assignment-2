digraph CFG {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.5", ranksep="0.35", fontname="DejaVu Sans", labelloc=t, label="Original registration_decision: control-flow graph\nShort-circuit expansion | N=19, E=27, V(G)=10\nHelpers are summarized; propagated helper exceptions are outside this graph", fontsize=18];
node [fontname="DejaVu Sans", fontsize=11, style=filled, fillcolor="#edf4fb", color="#335775"];
edge [fontname="DejaVu Sans",fontsize=10,color="#64748b"];
E [label="Entry", shape=oval];
D1 [label="D1 | L46\ndues < 0?", shape=diamond];
A [label="A | L48\n0 <= enrolled?", shape=diamond];
B [label="B | L48\nenrolled <= capacity?", shape=diamond];
C [label="C | L48\ncapacity < 1?", shape=diamond];
D3 [label="D3 | L50\ndues > 1000?", shape=diamond];
D4 [label="D4 | L52\nalready registered?", shape=diamond];
D5 [label="D5 | L54\nnot prerequisites_satisfied(...)?", shape=diamond];
D6 [label="D6 | L56\nnot check_credit_limit(...)?", shape=diamond];
D7 [label="D7 | L58\nenrolled > capacity?", shape=diamond];
X1 [label="X1 | L47\nraise Invalid dues", shape=box];
X2 [label="X2 | L49\nraise Invalid capacity or enrollment", shape=box];
R1 [label="R1 | L51\nreturn DUES_BLOCK", shape=box];
R2 [label="R2 | L53\nreturn ALREADY_REGISTERED", shape=box];
R3 [label="R3 | L55\nreturn PREREQUISITES_MISSING", shape=box];
R4 [label="R4 | L57\nreturn CREDIT_LIMIT", shape=box];
R5 [label="R5 | L59\nreturn WAITLISTED\nINFEASIBLE on valid ordinary inputs", shape=box, fillcolor="#fee2e2", color="#b91c1c"];
R6 [label="R6 | L60\nreturn REGISTERED", shape=box];
Z [label="Unified exit", shape=oval];
E -> D1 [label=""];
D1 -> X1 [label="T"];
D1 -> A [label="F"];
A -> X2 [label="F"];
A -> B [label="T"];
B -> X2 [label="F"];
B -> C [label="T"];
C -> X2 [label="T"];
C -> D3 [label="F"];
D3 -> R1 [label="T"];
D3 -> D4 [label="F"];
D4 -> R2 [label="T"];
D4 -> D5 [label="F"];
D5 -> R3 [label="T"];
D5 -> D6 [label="F"];
D6 -> R4 [label="T"];
D6 -> D7 [label="F"];
D7 -> R5 [label="T", color="#b91c1c", style=dashed];
D7 -> R6 [label="F"];
X1 -> Z [label="", color="#b6c2ce"];
X2 -> Z [label="", color="#b6c2ce"];
R1 -> Z [label="", color="#b6c2ce"];
R2 -> Z [label="", color="#b6c2ce"];
R3 -> Z [label="", color="#b6c2ce"];
R4 -> Z [label="", color="#b6c2ce"];
R5 -> Z [label="", color="#b6c2ce"];
R6 -> Z [label="", color="#b6c2ce"];
}
